# ─────────────────────────────────────────────────────────────
# T7 HealthVault — PHC Admin Panel environment
# Copy to `.env.local` for local dev. On Vercel, add these under
# Project → Settings → Environment Variables.
#
# Everything prefixed with VITE_ is bundled into the browser JS
# and is PUBLIC. Never put a Supabase service_role key here.
# ─────────────────────────────────────────────────────────────

# Which backend the panel talks to:
#   mock     → in-memory demo data + dummy login (no database needed)
#   supabase → real Supabase Auth + Postgres (requires the two vars below)
VITE_BACKEND=mock

# ── Supabase (only read when VITE_BACKEND=supabase) ──────────
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Dummy login (only read when VITE_BACKEND=mock) ───────────
# These are NOT secrets — they ship in the JS bundle. They exist only
# so the skeleton can be clicked through before Supabase is wired up.
