# ── Dependencies ─────────────────────────────
node_modules/
.pnpm-store/

# ── Build output / caches ────────────────────
dist/
dist-ssr/
build/
*.local
.vite/
node_modules/.vite/
*.tsbuildinfo
coverage/
.eslintcache

# ── Environment / secrets ────────────────────
# Real keys live in .env.local (local) or Vercel env settings — never in git.
.env
.env.*
!.env.example

# ── Deploy / platform ────────────────────────
.vercel/
# Supabase CLI local state (migrations/ stays tracked)
supabase/.temp/
supabase/.branches/
supabase/.env

# ── Logs ─────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS ──────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
