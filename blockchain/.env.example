# ─── HealthVault Blockchain Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Only commit .env.example

# ─── Deployer / Admin wallet private key (BridgeKey export or new key)
# This account pays gas for all deployments and admin transactions.
DEPLOYER_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# ─── Relay signing key (separate from admin — created just for the relay server)
# Worker transactions are signed by this key server-side (custodial pilot flow).
RELAY_PRIVATE_KEY=0x_YOUR_RELAY_PRIVATE_KEY_HERE

# ─── Hospital BridgeKey address (not private key — just the public address)
# Used in deploy script to call setHospital(). Hospital signs via BridgeKey in the web app.
HOSPITAL_ADDRESS=0x_HOSPITAL_BRIDGEKEY_ADDRESS_HERE

# ─── MSTScan API key (optional — for contract verification)
MSTSCAN_API_KEY=

# ─── Deployed contract addresses (filled in automatically by deploy script)
# You can also fill these manually after deployment.
WORKER_REGISTRY_ADDRESS=
CARECOIN_ADDRESS=
STIPEND_VAULT_ADDRESS=
CONSENT_REGISTRY_ADDRESS=
RECORD_ANCHOR_ADDRESS=
