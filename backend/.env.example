# ─── HealthVault Relay — Environment Variables ──────────────────────────────
# Copy to .env and fill values. NEVER commit .env.

# ─── MST Testnet RPC
MST_RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_ID=91562037

# ─── Relay signing key (holds worker private keys for custodial pilot)
# This is the key that signs ALL worker transactions on behalf of workers.
RELAY_PRIVATE_KEY=0x_YOUR_RELAY_PRIVATE_KEY_HERE

# ─── Contract addresses (copy from blockchain/contracts.json after deploy)
WORKER_REGISTRY_ADDRESS=0x
CARECOIN_ADDRESS=0x
STIPEND_VAULT_ADDRESS=0x
CONSENT_REGISTRY_ADDRESS=0x
RECORD_ANCHOR_ADDRESS=0x

# ─── Admin BridgeKey address (for ownership checks)
ADMIN_ADDRESS=0x

# ─── Security
# A long random secret for signing relay-issued JWT tokens (generate with: openssl rand -hex 32)
RELAY_SECRET=change_me_to_a_long_random_secret

# ─── Optional: Railway/Render port
PORT=8000
